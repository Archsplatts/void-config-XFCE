@import "themes/catppuccin-default"

configuration {
    modi: "drun";
    show-icons: true;
    sort: true;
    levenshtein-sort: false;
    disable-history: true;
    sorting-method: "fzf";
    display-drun: "";
    drun-display-format: "{name}";
    font: "UbuntuNerd Font Regular 12";
    icon-theme: "Papirus-Dark";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: true;
    border: 0px solid;
    background-color: rgba(30,30,46,0.80);
    cursor: "default";
}

mainbox {
    spacing: 100px;
    padding: 100px 225px;
    border: 0px solid;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 10px;
    margin: 0% 28%;
    padding: 10px;
    border-radius: 6px;
    background-color: rgba(30,30,46,0.60);
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: inherit;
}

textbox-prompt-colon {
    expand: false;
    str: "::";
    background-color: transparent;
    text-color: inherit;
}

entry {
    background-color: transparent;
    text-color: inherit;
    cursor: text;
    placeholder: "Rechercher...";
    placeholder-color: inherit;
}

listview {
    columns: 8;
    lines: 4;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    border: 0px solid;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

element {
    spacing: 15px;
    padding: 35px 10px;
    border: 0px solid;
    border-radius: 15px;
    background-color: transparent;
    text-color: @foreground;
    orientation: vertical;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: white / 5%;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 96px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: @text;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

error-message {
    padding: 100px;
    border: 0px solid;
    background-color: black / 10%;
    text-color: @foreground;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    highlight: none;
}
