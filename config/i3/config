# VARIABLES
set $mod Mod4
set $term xfce4-terminal
set $fm thunar
set $menu rofi -show drun -config ~/.config/rofi/gnome-menu.rasi
set $editor xfce4-terminal -x micro
set $web firefox

# APPEARANCE
gaps inner 8
default_border pixel 3
default_floating_border pixel 3
default_orientation auto
smart_borders on

# WORKSPACES
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"

# RULES
for_window [class="Galculator"] floating enable
for_window [class="impression"] floating enable
for_window [class="org.gnome.FileRoller"] floating enable
for_window [class="pavucontrol"] floating enable

# AUTOSTART
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id feh --bg-fill $HOME/Images/Wallpapers/sunken-tower.png
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id redshift
exec_always --no-startup-id autotiling

include ~/.config/i3/bind.conf
include ~/.config/i3/theme.conf
