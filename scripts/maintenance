#!/bin/bash

set -euo pipefail 

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}=== Maintenance Archsplatts ===${NC}"
echo

echo -e "${JAUNE}>>> Recherche de mises à jour flatpak...${NC}"
flatpak update || echo "Aucun flatpak à mettre à jour."
echo

echo -e "${JAUNE}>>> Recherche de paquets orphelins...${NC}"
sudo xbps-remove -o || true
echo

echo -e "${JAUNE}>>> Recherche de fichiers .new...${NC}"
sudo xdiff -l || true
echo

echo -e "${VERT}=== Maintenance terminée ===${NC}"
echo
