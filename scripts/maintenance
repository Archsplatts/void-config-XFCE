#!/bin/bash

set -euo pipefail 

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}=== Maintenance Archsplatts ===${NC}"
echo

echo -e "${JAUNE}>>> Recherche de mises à jour Void...${NC}"
sudo xbps-install -Su || echo "Aucun paquet à mettre à jour."
echo

echo -e "${JAUNE}>>> Recherche de mises à jour flatpak...${NC}"
flatpak update || echo "Aucun flatpak à mettre à jour."
echo

echo -e "${JAUNE}>>> Nettoyage des paquets orphelins et du cache...${NC}"
sudo xbps-remove -oO
echo

echo -e "${JAUNE}>>> Vérification des services à redémarrer...${NC}"
xcheckrestart
echo

echo -e "${VERT}=== Maintenance terminée ===${NC}"
