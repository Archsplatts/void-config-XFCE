#!/usr/bin/env bash
set -euo pipefail

API_URL="https://api.github.com/repos/brave/brave-browser/releases/latest"
DEST_DIR="$HOME/Téléchargements"

mkdir -p "$DEST_DIR"

download_url=$(
  curl -fsSL "$API_URL" | jq -r '
    .assets
    | map(select(.name | test("^brave-origin_[0-9]+\\.[0-9]+\\.[0-9]+_amd64\\.deb$")))
    | first
    | .browser_download_url
  '
)

if [[ -z "$download_url" || "$download_url" == "null" ]]; then
  echo "Aucun paquet brave-origin stable amd64.deb trouvé." >&2
  exit 1
fi

filename=$(basename "$download_url")
echo "Téléchargement : $filename"
curl -fL -o "$DEST_DIR/$filename" "$download_url"
echo "Terminé : $DEST_DIR/$filename"   

cd $HOME/Téléchargements/
