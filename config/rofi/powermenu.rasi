@import "themes/catppuccin-default"

configuration {
    font: "UbuntuNerd Font 40";  
}

window {
	background-color: rgba(30,30,46,0.90); 
	border: 3px; 
	border-color: @teal;
	border-radius: 8px;
	padding: 8px;
	transparency: "real";
    width: 346px;              
}

mainbox {
    enabled: true;
    border-color: @selected;
    background-color: transparent;
    children: [ "listview" ];
}

listview {
	border: 0; 
	columns: 4;
	flow: horizontal;
    lines: 1;
	scrollbar: false; 
	spacing: 8px;
}

inputbar {
    enabled: false;
}   

element {
	padding: 5px;
	height: 75px;
}

element selected normal, element selected active {  
   	background-color: @surface1;
    border-radius: 8px;
    padding: 10px;
    text-color: @teal;
}

element normal normal {
    background-color: @surface0;
	border-radius: 8px;
    text-color: @text;
}

element alternate normal {
    background-color: @surface0;
	border-radius: 8px;
    text-color:	@text;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:	0.5;
    background-color: inherit;
    text-color: inherit;
}
