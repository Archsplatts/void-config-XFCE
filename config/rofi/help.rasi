@import "themes/catppuccin-default"

configuration {
    font: "UbuntuNerd Font 13";
}

element alternate normal {
    background-color: transparent;
    text-color: @text;
}

element normal normal {
	background-color: transparent;
}

element selected normal, element selected active {
    background-color: inherit;
    text-color: @text;
}

element-text {
    text-color: inherit;
}

inputbar {
    enabled: false;
}

listview {
	border: 0; 
	columns: 1;
    lines: 13;
 	padding: 2px 0px 0px;
	scrollbar: false;
    spacing: 6px;    
}

mainbox {
	padding: 14px;
}

window {
	background-color: rgba(30,30,46,0.90);  
	transparency: "real";
	border: 3px;
	border-color: @teal;
	border-radius: 8px;
	margin: 0px 0px 0px 8px;	    
    width: 25%;        
}   
