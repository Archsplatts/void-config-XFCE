#!/bin/bash

options="Ask Brave\0icon\x1fbrave
Films\0icon\x1fphotofilmstrip
Flathub\0icon\x1fapplication-vnd.flatpak
Handbook\0icon\x1fvoid-logo-notext
ProtonDB\0icon\x1fdistributor-logo-steamos
Youtube\0icon\x1fyoutube"

selection=$(echo -e "$options" | rofi -dmenu -show-icons -icon-theme "Papirus" -config ~/.config/rofi/web-menu.rasi)

if [[ -n "$selection" ]]; then
    case "$selection" in
   		"Ask Brave")
   		   	flatpak run com.brave.Browser https://search.brave.com/ask
   		   	;;  
		"Films")
			flatpak run com.brave.Browser https://movix.bet
			;;
		"Flathub")
			flatpak run com.brave.Browser https://flathub.org
			;;
		"Handbook")
   			flatpak run com.brave.Browser https://docs.voidlinux.org/
   			;;
        "ProtonDB")
            flatpak run com.brave.Browser https://www.protondb.com
            ;;
        "Youtube")                    
            flatpak run com.brave.Browser https://www.youtube.com
            ;; 
    esac
fi   
